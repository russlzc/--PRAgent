PRAGENT_HOST=127.0.0.1
PRAGENT_PORT=8080
PRAGENT_DB_PATH=pragent.db
PRAGENT_MAX_DIFF_BYTES=1048576
PRAGENT_MAX_STEPS=8
PRAGENT_TIMEOUT_SECONDS=120

# Login is disabled by default for local use. Enable it before exposing the service.
PRAGENT_AUTH_REQUIRED=false
PRAGENT_AUTH_SECRET=
PRAGENT_BOOTSTRAP_ADMIN_USERNAME=
PRAGENT_BOOTSTRAP_ADMIN_PASSWORD=
PRAGENT_DEFAULT_TENANT_ID=default
PRAGENT_SESSION_TTL_SECONDS=3600

# Required by docker-compose.yml. Use a strong, URL-safe value.
PRAGENT_POSTGRES_PASSWORD=

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local keeps the deterministic rule-only reviewer.
PRAGENT_LLM_PROVIDER=local

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
PRAGENT_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
PRAGENT_OPENROUTER_API_KEY=
PRAGENT_OPENROUTER_SITE_URL=
PRAGENT_OPENROUTER_APP_NAME=PR Review Agent

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
PRAGENT_LLM_BASE_URL=
PRAGENT_LLM_API_KEY=
PRAGENT_LLM_MODEL=

# Replay evaluation and evolution activation gate
PRAGENT_EVAL_MAX_CASES=5
PRAGENT_EVAL_MIN_CASES=3
PRAGENT_EVAL_MIN_HOLDOUT_CASES=2
PRAGENT_EVAL_MIN_IMPROVEMENT=0.01
PRAGENT_EVAL_MAX_METRIC_REGRESSION=0

# GitHub integration
PRAGENT_GITHUB_WEBHOOK_SECRET=
PRAGENT_GITHUB_TOKEN=
PRAGENT_AUTO_POST_REVIEW=false
PRAGENT_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
PRAGENT_DATABASE_URL=
PRAGENT_REDIS_URL=
PRAGENT_ASYNC_WORKERS=2
PRAGENT_QUEUE_MAX_ATTEMPTS=3
PRAGENT_QUEUE_LEASE_SECONDS=60
PRAGENT_SKILLS_DIR=skills
PRAGENT_SKILL_SANDBOX=true
PRAGENT_SKILL_TIMEOUT_SECONDS=30
PRAGENT_SKILL_MEMORY_MB=256
PRAGENT_SKILL_SIGNING_KEY=
PRAGENT_SKILL_CONTAINER_IMAGE=

# Repair verification and observability
PRAGENT_REPAIR_TEST_COMMAND=
PRAGENT_REPAIR_VERIFY_TIMEOUT_SECONDS=120
PRAGENT_AGENT_MAX_WORKERS=4
PRAGENT_AGENT_RETRIES=1
PRAGENT_COLLABORATION_ROUNDS=2
PRAGENT_AGENT_LOOP_MAX_STEPS=4
PRAGENT_AGENT_LOOP_TIMEOUT_SECONDS=45
PRAGENT_CONTEXT_MAX_TOKENS=12000
PRAGENT_CONTEXT_RESERVED_TOKENS=2500
PRAGENT_MEMORY_ENABLED=true
PRAGENT_MEMORY_RECALL_LIMIT=6
PRAGENT_MEMORY_WORKING_TTL_SECONDS=86400
PRAGENT_OTEL_ENDPOINT=
PRAGENT_OTEL_SERVICE_NAME=pragent
PRAGENT_ALERT_FAILURE_RATE=0.20
PRAGENT_ALERT_MIN_SAMPLES=10
PRAGENT_ALERT_WINDOW_SECONDS=900
PRAGENT_ALERT_WEBHOOK_URL=
PRAGENT_ALERT_SMTP_HOST=
PRAGENT_ALERT_EMAIL_TO=
PRAGENT_CONTINUOUS_EVAL_SECONDS=0

# GitHub App (installation flow: /github/install, callback: /github/setup)
PRAGENT_GITHUB_APP_ID=
PRAGENT_GITHUB_APP_SLUG=
PRAGENT_GITHUB_PRIVATE_KEY_PATH=
PRAGENT_PUBLIC_BASE_URL=http://127.0.0.1:8080
